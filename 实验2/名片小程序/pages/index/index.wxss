/**index.wxss**/
image {
  width: 100%;
}

.commet {
  text-align: center;
  font-size: 32rpx;
  color: darkcyan;
  font-weight: 600;
  margin: 40rpx 0 20rpx;
}

.body {
  background: #f5f9f8;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "PingFang SC", "Microsoft YaHei", sans-serif;
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

.card-wrap {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 139, 139, 0.08);
  padding: 50rpx 40rpx;
}

.item-block {
  margin-bottom: 40rpx;
}

/*标题带左侧短彩条装饰*/
.title {
  font-size: 28rpx;
  font-weight: bold;
  color: #006666;
  padding-left: 20rpx;
  border-left: 8rpx solid darkcyan;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #444;
}

/*分割线*/
.divider {
  height: 1rpx;
  background-color: #e2ecec;
  margin: 36rpx 0;
}