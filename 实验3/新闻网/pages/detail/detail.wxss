/* pages/detail/detail.wxss */

.detail-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 20rpx;
}

/* ===== 顶部导航 ===== */
.detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.header-back {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 16rpx;
  border-radius: 30rpx;
  transition: all 0.3s ease;
}

.header-back:active {
  background: rgba(0, 0, 0, 0.05);
  transform: scale(0.95);
}

.back-icon {
  font-size: 44rpx;
  font-weight: 300;
  color: #1a2332;
  line-height: 1;
}

.back-text {
  font-size: 28rpx;
  color: #1a2332;
  font-weight: 500;
}

.category-badge {
  display: inline-block;
  background: linear-gradient(135deg, #328EEB, #6ba8f0);
  color: white;
  font-size: 22rpx;
  padding: 8rpx 28rpx;
  border-radius: 30rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  box-shadow: 0 4rpx 16rpx rgba(50, 142, 235, 0.3);
}

/* ===== 文章标题区域 ===== */
.article-header {
  padding: 30rpx 30rpx 20rpx;
  background: #ffffff;
  margin: 0 20rpx 20rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
}

.title-wrapper {
  margin-bottom: 20rpx;
}

.article-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.6;
  color: #1a2332;
  letter-spacing: 2rpx;
  text-align: justify;
}

/* ===== 文章元信息 ===== */
.article-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f2f5;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #8a94a6;
  font-weight: 400;
}

.meta-divider {
  width: 2rpx;
  height: 20rpx;
  background: #e8ecf0;
}

/* ===== 封面图 ===== */
.cover-wrapper {
  position: relative;
  margin: 0 20rpx 20rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.cover-image {
  width: 100%;
  height: 420rpx;
  display: block;
  background: #e8ecf0;
}

.cover-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.3), transparent);
  pointer-events: none;
}

/* ===== 文章内容 ===== */
.article-body {
  padding: 0 20rpx;
  margin-bottom: 30rpx;
}

.content-wrapper {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
}

.content-decoration {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 30rpx;
}

.deco-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #328EEB, #6ba8f0);
  flex-shrink: 0;
}

.deco-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(to right, #328EEB, transparent);
  border-radius: 2rpx;
}

.article-content {
  display: block;
  font-size: 32rpx;
  line-height: 2.1;
  color: #2d3748;
  letter-spacing: 1.5rpx;
  text-align: justify;
  font-weight: 400;
}

/* ===== 底部操作栏 ===== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 200;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

/* ===== 收藏按钮 ===== */
.collect-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 60rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  min-width: 240rpx;
  height: 80rpx;
  line-height: 1;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.collect-btn:active {
  transform: scale(0.95);
}

.collect-text {
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

/* 未登录时的收藏按钮 */
.collect-btn.login-tip-btn {
  background: linear-gradient(135deg, #b0b8c4, #8a94a6);
  box-shadow: 0 4rpx 16rpx rgba(138, 148, 166, 0.3);
}

.collect-btn.login-tip-btn:active {
  box-shadow: 0 2rpx 12rpx rgba(138, 148, 166, 0.2);
}

/* 已收藏状态 */
.collect-btn.collected {
  background: linear-gradient(135deg, #ff6b6b, #ee5a24);
  box-shadow: 0 4rpx 20rpx rgba(238, 90, 36, 0.35);
}

.collect-btn.collected:active {
  box-shadow: 0 2rpx 12rpx rgba(238, 90, 36, 0.25);
}

/* 未收藏状态 */
.collect-btn.uncollected {
  background: linear-gradient(135deg, #328EEB, #6ba8f0);
  box-shadow: 0 4rpx 20rpx rgba(50, 142, 235, 0.35);
}

.collect-btn.uncollected:active {
  box-shadow: 0 2rpx 12rpx rgba(50, 142, 235, 0.25);
}

/* ===== 安全区域 ===== */
.safe-area {
  height: 120rpx;
}

/* ===== 动画 ===== */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.article-header {
  animation: fadeInUp 0.5s ease-out;
}

.cover-wrapper {
  animation: fadeInUp 0.6s ease-out 0.1s both;
}

.article-body {
  animation: fadeInUp 0.7s ease-out 0.2s both;
}

.bottom-actions {
  animation: fadeInUp 0.5s ease-out 0.3s both;
}