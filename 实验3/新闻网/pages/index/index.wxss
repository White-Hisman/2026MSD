/* pages/index/index.wxss */

/* 分类Tab样式 */
.category-tabs {
  display: flex;
  background: #ffffff;
  padding: 0;
  border-bottom: 1rpx solid #f0f2f5;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 28rpx 0 26rpx;
  font-size: 28rpx;
  color: #8a94a6;
  position: relative;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.tab-item.active {
  color: #328EEB;
  font-weight: 600;
  font-size: 30rpx;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 44rpx;
  height: 5rpx;
  background: linear-gradient(135deg, #328EEB, #6ba8f0);
  border-radius: 3rpx;
  box-shadow: 0 2rpx 8rpx rgba(50, 142, 235, 0.3);
}

/* 幻灯片容器 */
.swiper-wrapper {
  padding: 20rpx 20rpx 0;
  background: #f5f7fa;
}

swiper {
  width: 100%;
  height: 340rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

swiper-item image {
  width: 100%;
  height: 100%;
  background: #e8ecf0;
}

/* 新闻列表 */
.news-list {
  padding: 20rpx;
  background: #f5f7fa;
  min-height: 400rpx;
}

/* 分类标题 */
.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx 24rpx 8rpx;
}

.category-title-wrapper {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.category-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a2332;
  position: relative;
  padding-left: 24rpx;
}

.category-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #328EEB, #6ba8f0);
  border-radius: 3rpx;
}

.category-subtitle {
  font-size: 24rpx;
  color: #b0b8c4;
  font-weight: 400;
}

.category-count {
  font-size: 24rpx;
  color: #b0b8c4;
  background: #e8ecf0;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
}

/* 新闻项 */
.news-item {
  display: flex;
  padding: 24rpx 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  align-items: flex-start;
}

.news-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.news-item image {
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f0f2f5;
  object-fit: cover;
}

.news-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.news-title {
  font-size: 28rpx;
  color: #1a2332;
  line-height: 1.6;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.news-meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.news-date {
  font-size: 22rpx;
  color: #b0b8c4;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #8a94a6;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #c0c8d4;
}