/* pages/my/my.wxss */

/* ===== 登录区域 ===== */
.myLogin {
  min-height: 420rpx;
  background: linear-gradient(145deg, #328EEB 0%, #1a6bc4 60%, #0d4f96 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 40rpx 30rpx;
  position: relative;
  overflow: hidden;
}

/* 装饰圆 */
.myLogin::before {
  content: '';
  position: absolute;
  width: 700rpx;
  height: 700rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.06) 0%, transparent 70%);
  border-radius: 50%;
  top: -350rpx;
  right: -250rpx;
  animation: floatBubble 8s ease-in-out infinite;
}

.myLogin::after {
  content: '';
  position: absolute;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255,255,255,0.04) 0%, transparent 70%);
  border-radius: 50%;
  bottom: -200rpx;
  left: -150rpx;
  animation: floatBubble 10s ease-in-out infinite reverse;
}

@keyframes floatBubble {
  0%, 100% { transform: translate(0, 0) scale(1); }
  50% { transform: translate(30rpx, -30rpx) scale(1.05); }
}

/* ===== 已登录状态 ===== */
.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

/* 已登录头像 - 强制正圆 */
.avatar {
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50% !important;
  border: 6rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.2);
  margin-bottom: 16rpx;
  object-fit: cover;
  background: #e8ecf0;
  transition: all 0.3s ease;
  flex-shrink: 0;
  min-width: 160rpx;
  max-width: 160rpx;
  min-height: 160rpx;
  max-height: 160rpx;
}

.avatar:active {
  transform: scale(0.95);
}

.nickname {
  color: white;
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.15);
  margin-bottom: 6rpx;
}

.user-badge {
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  color: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
  padding: 4rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

/* ===== 未登录状态 - 头像选择（强制正圆） ===== */
.avatar-wrapper {
  position: relative;
  z-index: 1;
  width: 140rpx !important;
  height: 140rpx !important;
  border-radius: 50% !important;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.15);
  padding: 0 !important;
  margin: 0 0 14rpx 0 !important;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
  min-width: 140rpx !important;
  max-width: 140rpx !important;
  min-height: 140rpx !important;
  max-height: 140rpx !important;
  line-height: 140rpx !important;
}

.avatar-wrapper:active {
  transform: scale(0.92);
  border-color: rgba(255, 255, 255, 0.8);
}

.avatar-select {
  width: 140rpx !important;
  height: 140rpx !important;
  display: block;
  object-fit: cover;
  border-radius: 50% !important;
  min-width: 140rpx !important;
  max-width: 140rpx !important;
  min-height: 140rpx !important;
  max-height: 140rpx !important;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent 60%);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 14rpx 0 10rpx;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.edit-icon {
  font-size: 20rpx;
}

/* ===== 昵称输入框 ===== */
.nickname-wrapper {
  display: flex;
  align-items: center;
  width: 300rpx;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10rpx);
  border-radius: 40rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  position: relative;
  z-index: 1;
  padding: 0 20rpx;
  margin-bottom: 16rpx;
  transition: all 0.3s ease;
  height: 64rpx;
}

.nickname-wrapper:focus-within {
  border-color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.25);
  box-shadow: 0 0 30rpx rgba(255, 255, 255, 0.1);
}

.input-icon {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-right: 12rpx;
}

.nickname-input {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  color: white;
  background: transparent;
  border: none;
  outline: none;
}

.placeholder-style {
  color: rgba(255, 255, 255, 0.5) !important;
  font-size: 24rpx;
}

/* ===== 登录按钮 ===== */
.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0f4ff 100%);
  color: #328EEB;
  border-radius: 40rpx;
  padding: 16rpx 50rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
  width: auto;
  min-width: 260rpx;
  position: relative;
  z-index: 1;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  letter-spacing: 2rpx;
  height: 72rpx;
}

.login-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.btn-icon {
  font-size: 28rpx;
}

/* ===== 退出按钮 ===== */
.logout-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10rpx);
  color: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
  padding: 12rpx 40rpx;
  font-size: 26rpx;
  width: auto;
  min-width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  position: relative;
  z-index: 1;
  transition: all 0.3s ease;
  letter-spacing: 1rpx;
}

.logout-btn:active {
  background: rgba(255, 255, 255, 0.2);
  transform: scale(0.95);
}

.logout-icon {
  font-size: 28rpx;
  display: inline-block;
  transform: rotate(45deg);
}

/* ===== 收藏列表 ===== */
.myFavorite {
  padding: 20rpx 20rpx 40rpx;
  min-height: 400rpx;
  background: #f5f7fa;
}

.favorite-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 8rpx 24rpx 8rpx;
}

.favorite-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-icon {
  font-size: 32rpx;
}

.favorite-title text:last-child {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2332;
  position: relative;
  padding-left: 4rpx;
}

.favorite-count {
  font-size: 24rpx;
  color: #8a94a6;
  background: #e8ecf0;
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 新闻列表 */
.news-list {
  padding: 4rpx 0;
}

.news-item {
  display: flex;
  padding: 24rpx 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  align-items: flex-start;
}

.news-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.news-item image {
  width: 180rpx;
  height: 140rpx;
  border-radius: 14rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #f0f2f5;
  object-fit: cover;
}

.news-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.news-title {
  font-size: 28rpx;
  color: #1a2332;
  line-height: 1.6;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.news-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.news-info .date {
  font-size: 22rpx;
  color: #b0b8c4;
  font-weight: 400;
}

.read-icon {
  font-size: 28rpx;
  color: #b0b8c4;
  transition: all 0.3s ease;
}

.news-item:active .read-icon {
  transform: translateX(8rpx);
  color: #328EEB;
}

.category-tag {
  display: inline-block;
  background: linear-gradient(135deg, #328EEB, #6ba8f0);
  color: white;
  font-size: 18rpx;
  padding: 2rpx 16rpx;
  border-radius: 10rpx;
  margin-bottom: 8rpx;
  align-self: flex-start;
  letter-spacing: 1rpx;
}

/* ===== 空状态 ===== */
.login-tip-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0 80rpx;
}

.tip-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.tip-text {
  font-size: 32rpx;
  color: #8a94a6;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: #c0c8d4;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 100rpx;
}

.empty-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  background: #e8ecf0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon {
  font-size: 60rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #4a5568;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #b0b8c4;
  margin-bottom: 30rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #328EEB, #6ba8f0);
  color: white;
  border-radius: 50rpx;
  padding: 16rpx 60rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 20rpx rgba(50, 142, 235, 0.3);
  transition: all 0.3s ease;
}

.empty-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}