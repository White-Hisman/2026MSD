/* app.wxss */

/* 页面容器样式 */
.container {
  height: 100vh;
  color: #E64340; 
  font-weight: bold;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-evenly;
}

/* 顶端标题样式 */
.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #E64340;
  text-shadow: 2rpx 2rpx 8rpx rgba(230, 67, 64, 0.2);
}