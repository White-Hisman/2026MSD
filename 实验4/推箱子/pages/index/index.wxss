/* pages/index/index.wxss */

page {
  background: linear-gradient(145deg, #f8f9fa 0%, #e9ecef 100%);
  min-height: 100vh;
}

.title {
  font-size: 56rpx;
  font-weight: bold;
  color: #E64340;
  margin-top: 20rpx;
  text-shadow: 4rpx 4rpx 12rpx rgba(230, 67, 64, 0.2);
}

.sub-title {
  font-size: 28rpx;
  color: #888;
  margin-top: -10rpx;
  margin-bottom: 20rpx;
}

.levelBox {
  width: 92%;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 10rpx;
}

.box {
  position: relative;
  width: 48%;
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.10);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0 20rpx;
  margin-bottom: 30rpx;
  transition: all 0.3s ease;
  border: 4rpx solid transparent;
  overflow: hidden;
}

.box:active {
  transform: scale(0.95);
}

.lock-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.lock-icon {
  font-size: 80rpx;
}

.box image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: #f0f0f0;
  border: 3rpx solid #e0e0e0;
}

.box image.locked {
  filter: grayscale(0.6);
  opacity: 0.6;
}

.level-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 16rpx;
  width: 100%;
}

.level-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.level-tip {
  font-size: 22rpx;
  color: #E64340;
  margin-top: 6rpx;
  opacity: 0.6;
}

.locked-text {
  color: #999;
  opacity: 1;
}

/* ===== 关卡详情弹窗 ===== */
.modal-mask {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  bottom: 0 !important;
  background: rgba(0, 0, 0, 0.55) !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  z-index: 9999 !important;
  animation: fadeIn 0.3s ease;
}

.modal-content {
  background: #fff;
  border-radius: 48rpx;
  padding: 50rpx 40rpx 40rpx;
  width: 85%;
  max-width: 600rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.3);
  position: relative;
}

.modal-close {
  position: absolute;
  top: 20rpx;
  right: 30rpx;
  font-size: 36rpx;
  color: #999;
  padding: 10rpx;
  cursor: pointer;
}

.modal-close:active {
  color: #E64340;
}

.modal-level-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #E64340;
  margin-bottom: 16rpx;
}

.modal-stars {
  display: flex !important;
  flex-direction: row !important;
  gap: 12rpx !important;
  margin: 10rpx 0 20rpx !important;
}

.modal-stars .star {
  font-size: 56rpx !important;
  opacity: 0.25 !important;
  transition: all 0.5s ease !important;
}

.modal-stars .star.active {
  opacity: 1 !important;
}

.modal-history {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  width: 100%;
}

.history-label {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 6rpx;
}

.history-steps {
  font-size: 30rpx;
  color: #555;
}

.history-steps .highlight {
  color: #E64340;
  font-weight: bold;
  font-size: 36rpx;
}

.history-steps.empty {
  color: #bbb;
  font-size: 28rpx;
}

.modal-btns {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  width: 100%;
  justify-content: center;
}

.modal-btn {
  flex: 1;
  padding: 24rpx 0 !important;
  border-radius: 50rpx !important;
  font-size: 30rpx !important;
  font-weight: bold !important;
  border: none !important;
  transition: all 0.3s ease !important;
}

.modal-btn:active {
  transform: scale(0.94);
}

.start-btn {
  background: #E64340 !important;
  color: #fff !important;
  box-shadow: 0 6rpx 24rpx rgba(230, 67, 64, 0.35) !important;
}

@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}