<view class="add-container">
  <!-- 标题 -->
  <view class="add-header">
    <text class="add-title">📸 发布新作品</text>
  </view>

  <!-- 上传表单 -->
  <view class="add-form">
    <!-- 选择图片 -->
    <view class="form-group">
      <text class="form-label">选择图片 <text class="required">*</text></text>
      <view class="image-picker" bindtap="chooseImage">
        <view wx:if="{{!tempImage}}" class="picker-placeholder">
          <text class="picker-icon">+</text>
          <text class="picker-text">点击选择图片</text>
        </view>
        <image wx:else class="picker-image" src="{{tempImage}}" mode="aspectFill"></image>
        <view wx:if="{{tempImage}}" class="picker-remove" catchtap="removeImage">✕</view>
      </view>
    </view>

    <!-- 图片描述 -->
    <view class="form-group">
      <text class="form-label">图片描述</text>
      <input class="form-input" placeholder="写点什么吧..." bindinput="onDescInput" value="{{desc}}" maxlength="50" />
      <text class="char-count">{{desc.length || 0}}/50</text>
    </view>

    <!-- 拍摄位置 -->
    <view class="form-group">
      <text class="form-label">拍摄位置</text>
      <view class="location-box" bindtap="chooseLocation">
        <text class="location-text {{location ? '' : 'placeholder'}}">{{location || '点击选择位置'}}</text>
        <text class="location-arrow">›</text>
      </view>
    </view>

    <!-- 发布按钮 -->
    <button class="publish-btn {{tempImage ? '' : 'disabled'}}" bindtap="submitUpload" disabled="{{!tempImage}}">
      {{tempImage ? '🚀 发布' : '请先选择图片'}}
    </button>
  </view>
</view>