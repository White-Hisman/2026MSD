.add-container {
  min-height: 100vh;
  background: #f0f2f5;
  padding: 30rpx 30rpx 60rpx;
  box-sizing: border-box;
}

/* 标题 */
.add-header {
  margin-bottom: 30rpx;
}

.add-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2c3e50;
}

/* 表单 */
.add-form {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.form-group {
  margin-bottom: 32rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

.required {
  color: #e74c3c;
}

/* 图片选择器 */
.image-picker {
  width: 100%;
  height: 320rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  border: 4rpx dashed #dce1eb;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  transition: all 0.3s;
}

.image-picker:active {
  border-color: #667eea;
}

.picker-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #bdc3c7;
}

.picker-icon {
  font-size: 80rpx;
  font-weight: 300;
  color: #dce1eb;
}

.picker-text {
  font-size: 28rpx;
  margin-top: 12rpx;
}

.picker-image {
  width: 100%;
  height: 100%;
}

.picker-remove {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #2c3e50;
  box-sizing: border-box;
  border: 2rpx solid transparent;
}

.form-input:focus {
  border-color: #667eea;
  background: #ffffff;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #bdc3c7;
  margin-top: 6rpx;
}

/* 位置选择 */
.location-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 80rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 20rpx;
  border: 2rpx solid transparent;
}

.location-box:active {
  border-color: #667eea;
  background: #ffffff;
}

.location-text {
  font-size: 28rpx;
  color: #2c3e50;
  flex: 1;
}

.location-text.placeholder {
  color: #bdc3c7;
}

.location-arrow {
  font-size: 32rpx;
  color: #bdc3c7;
}

/* 发布按钮 */
.publish-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 44rpx;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  margin-top: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.3);
}

.publish-btn:active {
  transform: scale(0.97);
}

.publish-btn.disabled {
  background: #dce1eb !important;
  box-shadow: none !important;
}

.publish-btn[disabled] {
  opacity: 0.6;
}