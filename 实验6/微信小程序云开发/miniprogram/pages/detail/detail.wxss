.detail-container {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 30rpx;
}

/* 顶部标题 */
.detail-header {
  background: #ffffff;
  padding: 24rpx 30rpx;
  text-align: center;
  border-bottom: 2rpx solid #f0f2f5;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2c3e50;
}

/* 图片 */
.image-wrapper {
  background: #0a0a0a;
  display: flex;
  justify-content: center;
}

.detail-image {
  width: 100%;
  display: block;
}

/* 图片信息 */
.info-wrapper {
  background: #ffffff;
  margin: 16rpx 20rpx;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-row {
  display: flex;
  align-items: center;
}

.info-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  border: 2rpx solid #e8edff;
  flex-shrink: 0;
}

.info-text {
  flex: 1;
}

.info-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  display: block;
}

.info-location {
  font-size: 22rpx;
  color: #95a5a6;
}

.info-date {
  font-size: 22rpx;
  color: #bdc3c7;
  flex-shrink: 0;
}

.info-desc {
  display: block;
  font-size: 28rpx;
  color: #2c3e50;
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #f0f2f5;
  line-height: 1.6;
}

/* ====== 按钮区域 - 纯文字 ====== */
.btn-row {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 30rpx 40rpx;
  margin: 0 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.action-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 8rpx;
  padding: 0;
}

.action-btn:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 下载按钮 - 紫色 */
.download-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

/* 分享按钮 - 橙色 */
.share-btn {
  background: #fff5e6;
  color: #e67e22;
  border: 2rpx solid #fdebd0;
}

/* 预览按钮 - 绿色 */
.preview-btn {
  background: #e8f8f5;
  color: #1abc9c;
  border: 2rpx solid #d1f2eb;
}