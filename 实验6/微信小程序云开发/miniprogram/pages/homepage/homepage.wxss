.homepage-container {
  min-height: 100vh;
  background: linear-gradient(145deg, #f5f0ff 0%, #e8f0fe 50%, #f0f5ff 100%);
  padding: 20rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ====== 用户信息 ====== */
.user-header {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 24rpx rgba(102, 126, 234, 0.08);
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #667eea;
  margin-right: 18rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.2);
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  display: block;
}

.user-location {
  font-size: 22rpx;
  color: #95a5a6;
  margin-top: 2rpx;
}

.photo-count {
  font-size: 22rpx;
  color: #667eea;
  background: linear-gradient(135deg, #e8edff, #f0e6ff);
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.logout-btn-mini {
  flex-shrink: 0;
  padding: 10rpx 22rpx;
  background: rgba(254, 238, 238, 0.9);
  color: #e74c3c;
  border-radius: 30rpx;
  font-size: 22rpx;
  font-weight: 500;
  border: 2rpx solid rgba(245, 198, 203, 0.5);
  margin-left: 12rpx;
}

.logout-btn-mini:active {
  transform: scale(0.95);
  background: #fdd;
}

/* ====== 统计栏 ====== */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20rpx;
  padding: 16rpx 12rpx;
  margin-bottom: 16rpx;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.06);
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-number {
  font-size: 32rpx;
  font-weight: 700;
  color: #667eea;
}

.stats-label {
  font-size: 20rpx;
  color: #95a5a6;
  margin-top: 2rpx;
}

.stats-divider {
  width: 2rpx;
  height: 36rpx;
  background: #e8edff;
}

/* ====== 分割线 ====== */
.divider {
  text-align: center;
  margin: 10rpx 0 18rpx;
  position: relative;
}

.divider::before,
.divider::after {
  content: '';
  position: absolute;
  top: 50%;
  width: 28%;
  height: 2rpx;
  background: linear-gradient(to right, transparent, #dce1eb);
}

.divider::before {
  left: 0;
}

.divider::after {
  right: 0;
  background: linear-gradient(to left, transparent, #dce1eb);
}

.divider-text {
  font-size: 26rpx;
  color: #95a5a6;
  background: transparent;
  padding: 0 20rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}

/* ====== 图片网格 - 3列，无空隙 ====== */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -6rpx;
}

.photo-item {
  width: 33.33%;
  padding: 0 6rpx 12rpx;
  box-sizing: border-box;
  border-radius: 0;
  overflow: hidden;
  position: relative;
  background: transparent;
  box-shadow: none;
  backdrop-filter: none;
  border: none;
}

.photo-wrapper {
  display: block;
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
  background: #f0f2f5;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.08);
}

.photo-wrapper:active {
  transform: scale(0.97);
}

.photo-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  transition: transform 0.3s;
}

.photo-wrapper:active .photo-img {
  transform: scale(1.05);
}

/* ====== 序号角标 ====== */
.photo-index {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(102, 126, 234, 0.85);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  z-index: 2;
}

/* ====== 图片底部信息 ====== */
.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12rpx 10rpx 8rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, rgba(0, 0, 0, 0.1) 80%, transparent 100%);
  z-index: 1;
  border-radius: 0 0 16rpx 16rpx;
}

.photo-desc {
  font-size: 20rpx;
  color: #ffffff;
  font-weight: 500;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* ====== 删除按钮 ====== */
.del-btn {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(231, 76, 60, 0.92);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  z-index: 5;
  box-shadow: 0 4rpx 16rpx rgba(231, 76, 60, 0.35);
  backdrop-filter: blur(10px);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  transition: all 0.2s;
}

.del-btn:active {
  transform: scale(1.15);
  background: #e74c3c;
}

/* ====== 空状态 ====== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 24rpx;
  backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #95a5a6;
  font-weight: 600;
}

.empty-hint {
  font-size: 24rpx;
  color: #bdc3c7;
  margin-top: 12rpx;
}