/* 页面整体 */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx 40rpx;
  box-sizing: border-box;
}

/* 顶部区域 */
.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.logo-wrapper {
  position: relative;
  margin-bottom: 30rpx;
}

.logo-circle {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(20px);
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.logo-icon {
  font-size: 80rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.app-slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
}

/* 登录表单 */
.login-form {
  width: 100%;
  max-width: 680rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx;
  padding: 50rpx 40rpx 40rpx;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(20px);
  animation: slideUp 0.6s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

/* 头像选择 */
.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-picker {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx dashed #dce1eb;
  margin-bottom: 12rpx;
  transition: all 0.3s;
}

.avatar-picker:active {
  transform: scale(0.95);
  border-color: #667eea;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #f5f7fa;
}

.avatar-upload-btn {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border: 3rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.form-hint {
  font-size: 22rpx;
  color: #bdc3c7;
}

/* 输入框 */
.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.input-wrapper:focus-within {
  border-color: #667eea;
  background: #ffffff;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.1);
}

.form-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #2c3e50;
  background: transparent;
  border: none;
}

.form-input::placeholder {
  color: #bdc3c7;
}

.input-count {
  font-size: 22rpx;
  color: #bdc3c7;
  padding-right: 24rpx;
  flex-shrink: 0;
}

/* 位置选择 */
.location-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.location-selector:active {
  border-color: #667eea;
  background: #ffffff;
}

.location-text {
  font-size: 30rpx;
  color: #2c3e50;
  flex: 1;
}

.location-text.placeholder {
  color: #bdc3c7;
}

.location-icon {
  font-size: 36rpx;
  color: #bdc3c7;
}

/* 性别选择 */
.gender-group {
  display: flex;
  gap: 16rpx;
}

.gender-option {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #95a5a6;
  border: 3rpx solid transparent;
  transition: all 0.3s;
}

.gender-option:active {
  transform: scale(0.95);
}

.gender-option.active {
  background: linear-gradient(135deg, #e8edff 0%, #f0e6ff 100%);
  border-color: #667eea;
  color: #667eea;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.15);
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 48rpx;
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  margin-top: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s;
}

.login-btn:active {
  transform: scale(0.97);
}

.login-btn.disabled {
  background: #dce1eb !important;
  box-shadow: none !important;
  opacity: 0.6;
}

.login-btn[disabled] {
  opacity: 0.6;
}

.login-footer {
  text-align: center;
  margin-top: 28rpx;
  font-size: 22rpx;
  color: #bdc3c7;
}
.container {
  min-height: 100vh;
  background: linear-gradient(145deg, #f5f0ff 0%, #e8f0fe 50%, #f0f5ff 100%);
  padding: 20rpx 30rpx 60rpx;
  box-sizing: border-box;
}