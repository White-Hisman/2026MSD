/* index.wxss */
.box {
  background: #f5f9f8;
  min-height: 100vh;
  padding: 30rpx;
  box-sizing: border-box;
}

.pic {
  width: 100%;
}
.pic image {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 16rpx;
}

.title {
  text-align: center;
  font-size: 32rpx;
  color: darkcyan;
  font-weight: 600;
  margin: 40rpx 0 20rpx;
}

.main {
  background: #f5f9f8;
  padding: 0;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 139, 139, 0.08);
  padding: 50rpx 40rpx;
}

.item {
  margin-bottom: 30rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
}
.item:last-child {
  margin-bottom: 0;
}
.item:active {
  background: #f0f7f6;
}

.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0;
}

.name {
  font-size: 28rpx;
  font-weight: bold;
  color: #006666;
  padding-left: 20rpx;
  border-left: 8rpx solid darkcyan;
  flex: 1;
}

.icon {
  font-size: 28rpx;
  color: #6b9b9b;
  margin-left: 16rpx;
  transition: transform 0.25s ease;
  width: 36rpx;
  text-align: center;
}
.icon.up {
  transform: rotate(180deg);
  color: darkcyan;
}

.body {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.35s ease, opacity 0.25s ease;
  opacity: 0;
  padding-left: 20rpx;
  border-left: 2rpx solid #d9eceb;
  margin-left: 12rpx;
}

.body.open {
  max-height: 600rpx;
  opacity: 1;
  padding-bottom: 6rpx;
}

.text {
  font-size: 26rpx;
  line-height: 1.8;
  color: #444;
  padding-right: 12rpx;
  padding-bottom: 8rpx;
}

.line {
  height: 1rpx;
  background-color: #e2ecec;
  margin: 36rpx 0;
}
.line:last-of-type {
  display: none;
}
.item + .line {
  margin-top: 12rpx;
}
.line + .item {
  margin-top: 0;
}